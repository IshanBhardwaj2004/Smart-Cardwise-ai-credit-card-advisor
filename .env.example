
# Copy this file to .env and add your own settings.

# --- MCP server ---
MCP_URL=https://bk-api.bankkaro.com/mcp
MCP_MODE=live
MCP_TIMEOUT=20
MCP_RETRIES=2

# --- LLM (Groq API) ---
LLM_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=qwen/qwen3-32b
LLM_API_KEY=your_groq_api_key_here
LLM_MODE=live
LLM_TIMEOUT=60

# --- traces ---
TRACE_DIR=traces

# --- rules ---
# RULES_PATH=app/rules.json
