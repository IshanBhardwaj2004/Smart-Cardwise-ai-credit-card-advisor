  "validation": {
    "max_fee": 1000000,
    "rounding_tolerance": 1,
    "formula_checks": [
      {
        "name": "net_savings_math",
        "result": "net_savings",
        "plus": [
          "rewards",
          "milestone",
          "lounge"
        ],
        "minus": [
          "annual_fee"
        ],
        "fault": "mcp_tool",
        "warn_user": true,
        "problem": "net savings does not match the tool's own formula (rewards + milestone + lounge - annual fee)"
      },
      {
        "name": "description_says_joining_fee_is_subtracted",
        "result": "net_savings",
        "plus": [
          "rewards",
          "milestone",
          "lounge"
        ],
        "minus": [
          "joining_fee",
          "annual_fee"
        ],
        "only_if_nonzero": "joining_fee",
        "fault": "mcp_tool",
        "warn_user": false,
        "problem": "recommend_cards description says net savings subtracts the joining fee, but the numbers do not"
      }
    ],
    "zero_ranking": {
      "fault": "mcp_tool",
      "warn_user": true,
      "problem": "tool returned ranked cards although every card shows zero savings"
    },
    "breakdown_period": {
      "fault": "mcp_tool",
      "warn_user": false,
      "problem": "category breakdown is labelled annual but x12 equals the annual rewards, so it looks monthly"
    },
    "income_consistency": {
      "tolerance": 0.1,
      "fault": "data",
      "warn_user": false,
      "problem": "minimum income in LPA and minimum monthly income do not agree"
    },
    "monthly_looks_yearly": {
      "fault": "data",
      "warn_user": false,
      "problem": "minimum monthly income is about as big as the yearly minimum (LPA), so it looks like a yearly figure in the monthly field"
    },
    "name_mismatch": {
      "fault": "data",
      "warn_user": false,
      "problem": "card name differs from the card list for the same alias"
    },
    "milestone_heavy": {
      "share": 0.5,
      "fault": "mcp_tool",
      "warn_user": false,
      "problem": "more than half of this card's value is a milestone benefit counted at full value, which can outrank cards that pay more on the actual spending"
    }
  },
