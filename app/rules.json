  "guards": {
    "input_block": [
      {
        "name": "sensitive_data",
        "patterns": [
          "(?<!\\d)(?:\\d[ -]?){12,18}\\d(?!\\d)",
          "(?<!\\d)\\d{4}[ -]?\\d{4}[ -]?\\d{4}(?!\\d)",
          "\\b[a-z]{5}\\d{4}[a-z]\\b",
          "\\b(otp|cvv)\\b\\W{0,5}\\d{3,6}"
        ],
        "message": "Please don't share card numbers, OTPs, CVVs, Aadhaar or PAN here. I don't need them, and I haven't stored what you sent. Tell me roughly what you spend each month and where."
      },
      {
        "name": "prompt_injection",
        "patterns": [
          "\\b(ignore|forget|disregard|override|bypass)\\b.{0,25}\\b(rules?|instructions?|guidelines|guardrails|prompt|system)\\b",
          "\\b(pretend|act as if|role ?play)\\b.{0,30}\\b(no rules|bank|approv)",
          "\\bdeveloper mode\\b|\\bjailbreak\\b",
          "\\b(show|give|tell|reveal|print|share)\\b.{0,15}\\b(system prompt|your (prompt|instructions|rules))\\b"
        ],
        "message": "I can't change how I work. I only share card facts from the card data, and approval is always the bank's decision. Tell me about your spending and I'll suggest a card."
      },
      {
        "name": "approval_promise",
        "patterns": [
          "\\bguarantee(d|e)?\\b.*\\bapprov",
          "\\bapprov.*\\bguarantee",
          "\\bwill i (surely|definitely|100%?) get\\b",
          "\\bpakka\\b.*\\b(approv|milega|mil jayega)\\b",
          "\\bconfirm\\b.*\\bapprov",
          "\\b(definitely|surely|certainly|100\\s?%?)\\b.{0,20}\\b(get )?approv",
          "\\bapprov\\w*\\b.{0,20}\\b(100\\s?%|sure|certain|definite)"
        ],
        "message": "I can't promise approval. The bank makes the final decision, but I can show which cards you are likely eligible for."
      },
      {
        "name": "tax_advice",
        "patterns": [
          "\\btax\\b.*\\b(save|saving|deduct|benefit|file|return|evade|exempt)",
          "\\b(save|saving|deduct).*\\btax\\b",
          "\\b80c\\b|\\bgst\\b.*\\b(claim|file)",
          "\\bincome tax\\b",
          "\\b(claim|file|save)\\b.{0,15}\\bgst\\b"
        ],
        "message": "I can't give tax advice. Please talk to a qualified tax professional for that. I can help you choose or compare credit cards."
      },
      {
        "name": "off_topic_product",
        "patterns": [
          "\\b(personal |home |car |gold |business )loans?\\b",
          "\\b(need|want|get|suggest|best|buy|take)\\b.{0,15}\\bloans?\\b",
          "\\b(need|want|suggest|best|buy|which)\\b.{0,20}\\binsurance (policy|plan)\\b",
          "\\b(stocks?|share market|mutual funds?|crypto|bitcoin|demat)\\b",
          "\\b(fixed deposit|savings account)\\b"
        ],
        "message": "I only help with credit cards. For loans, insurance plans or investments you'll need a different service."
      }
    ],
    "banned_output": [
      {
        "name": "approval_promise",
        "pattern": "\\b(guaranteed|assured|definite|100%?)\\b.{0,20}\\bapprov"
      },
      {
        "name": "approval_promise_strong",
        "pattern": "\\byou will (surely|definitely|certainly) (get|be approved)"
      },
      {
        "name": "tax_advice",
        "pattern": "\\btax (benefit|saving|deduction)s?\\b"
      },
      {
        "name": "pii_request",
        "pattern": "\\b(otp|cvv|password|full card number|aadhaar number|pan number)\\b"
      }
    ],
    "min_checked_amount": 2,
    "redact_patterns": [
      "(?<!\\d)(?:\\d[ -]?){12,18}\\d(?!\\d)",
      "(?<!\\d)\\d{4}[ -]?\\d{4}[ -]?\\d{4}(?!\\d)",
      "\\b[a-z]{5}\\d{4}[a-z]\\b",
      "\\b(otp|cvv)\\b\\W{0,5}\\d{3,6}"
    ]
  },
  "intent": {
    "rules": [
      {
        "intent": "compare",
        "patterns": [
          "\\bcompare\\b",
          "\\bvs\\.?\\b",
          "\\bversus\\b",
          "\\b(difference|differ) between\\b",
          "\\bkaunsa better\\b",
          "\\bwhich (is|one is) (better|best)\\b",
          "\\bor\\b.{0,40}\\bwhich (is )?better\\b",
          "\\bbetter\\b.{0,20}\\?\\s*$"
        ]
      },
      {
        "intent": "eligibility",
        "patterns": [
          "\\beligib",
          "\\bqualif",
          "\\bcan i get\\b",
          "\\bam i able\\b",
          "\\b(cards?|what) can i (get|apply)",
          "\\bmil (sakta|sakti|jayega)\\b"
        ]
      },
      {
        "intent": "card_details",
        "patterns": [
          "\\b(fee|fees|charges?|annual fee|joining fee)\\b",
          "\\b(benefits?|rewards?|lounge|cashback rate)\\b.*\\b(of|for|on)\\b",
          "\\btell me about\\b",
          "\\bdetails (of|about|for)\\b"
        ]
      },
      {
        "intent": "recommend",
        "patterns": [
          "\\bbest card\\b",
          "\\brecommend\\b",
          "\\bsuggest\\b",
          "\\bwhat card\\b",
          "\\bkaun ?sa card\\b",
          "\\bwhich (credit )?card\\b",
          "\\bbest (savings|cashback|rewards?)\\b",
          "\\bi spend\\b",
          "\\bmy spend",
          "\\bfor my spending\\b",
          "\\bshould i (get|take|use)\\b",
          "\\bworth it\\b"
        ]
      }
    ],
    "dominance_margin": 2
  },
